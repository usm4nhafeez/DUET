# DUET file database on Vercel — copy these names into Vercel → Settings → Environment Variables.
# jsonbin.io: Access Key from https://jsonbin.io/api-keys, Bin ID from your ledger bin.
# api/ledger.js reads both; missing values → /api/ledger returns 500 until set.
JSONBIN_ACCESS_KEY=
JSONBIN_BIN_ID=
